# Node dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime files
pids/
*.pid
*.seed

# Build / output
dist/
build/

# Environment variables (do not commit secrets)
.env
.env.*.local
.env.local

# Vercel / deployment artifacts
.vercel/

# Test coverage
coverage/
.nyc_output/

# Test results / artifacts
test-results/

# Caches
.cache/
.npm/
node_modules/.vite/

# Database / local storage
*.sqlite
*.sqlite3
*.db

# Uploaded/local files
uploads/
public/uploads/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
*.tgz
*.gz
*.zip
*.bak
*.tmp

# Secrets / keys
*.pem
*.key

# TypeScript
*.tsbuildinfo

# ESLint cache
.eslintcache

# Yarn PnP
.pnp.*

# Optional: ignore local development-only files
.env.development
.env.test
.env.production

