node_modules/.vite
.dist-ssr/

# Local environment variables (do not commit secrets)
.env
.env.*.local
.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage & results
coverage/
.nyc_output/
test-results/
playwright-report/

# Generated files (Tailwind, etc.)
output.css
src/output.css

# Caches & temp
.cache/
.tmp/
.vite/

# TypeScript
*.tsbuildinfo

# Editor/IDE
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Misc
*.tgz
*.zip
*.bak
*.tmp

# Keep lock files tracked (package-lock.json, yarn.lock, pnpm-lock.yaml)

